<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+): foreground = white anchor_rounded glyph on
     transparency; background = solid kit teal. Glyph is sized to 62% of
     the 108dp canvas, inside the 66dp safe zone, so no launcher mask
     crops it. Legacy ic_launcher.png files remain as fallback. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
