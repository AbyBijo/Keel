# Gradle / Android build outputs
*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
app/build/
captures/

# Keystores and signing — never commit the real ones.
# (The fixed DEBUG keystore is committed as base64 text in
# keystore/debug.keystore.b64 by design; the binary is generated into
# the build directory at configuration time.)
*.jks
*.keystore
key.properties
!keystore/debug.keystore.b64

# Local SDK / IDE
local.properties
